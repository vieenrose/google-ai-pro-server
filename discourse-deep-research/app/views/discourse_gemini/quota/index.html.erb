<%- # Sloth AI — admin page: plugin settings + quota monitor (server-rendered). -%>
<style>
  .agq-wrap { max-width: 900px; padding: 8px 0 24px; font-size: 14px; }
  .agq-wrap table { width: 100%; border-collapse: collapse; }
  .agq-wrap th { text-align: left; font-size: 12px; color: var(--primary-medium, #666);
                 padding: 6px 8px; border-bottom: 1px solid var(--primary-low, #ddd); }
  .agq-wrap td { padding: 8px; border-bottom: 1px solid var(--primary-low, #ddd);
                 vertical-align: middle; }
  .agq-key { color: var(--primary-medium, #777); font-size: 11px; font-family: monospace; }
  .agq-bar { background: var(--primary-low, #e5e5e5); border-radius: 5px; height: 10px;
             min-width: 180px; overflow: hidden; }
  .agq-fill { height: 100%; border-radius: 5px; }
  .agq-pct { margin-left: 8px; font-variant-numeric: tabular-nums; font-size: 13px; }
  .agq-reset { color: var(--primary-medium, #777); font-variant-numeric: tabular-nums; font-size: 13px; }
  .agq-warn { color: #c00; }
  .agq-sub { color: var(--primary-medium, #777); font-size: 13px; margin-bottom: 14px; }
  .agq-error { background: #fdecea; border: 1px solid #f5c6c6; color: #a33; padding: 12px; border-radius: 6px; }
  .agq-saved { background: #e7f6ec; border: 1px solid #b5dfc4; color: #167b3a; padding: 10px 12px; border-radius: 6px; margin-bottom: 12px; }
  .agq-box { border: 1px solid var(--primary-low, #ddd); border-radius: 8px; padding: 14px 16px; margin-bottom: 20px; }
  .agq-box h3 { margin: 0 0 10px; font-size: 15px; }
  .agq-box label { display: block; font-size: 13px; margin: 10px 0 4px; color: var(--primary-medium, #666); }
  .agq-box input[type="text"], .agq-box input[type="password"] { width: 100%; max-width: 520px;
    padding: 6px 8px; border: 1px solid var(--primary-low-mid, #bbb); border-radius: 4px;
    font-family: monospace; font-size: 13px; background: var(--secondary, #fff); color: var(--primary, #222); }
  .agq-box .hint { font-size: 12px; color: var(--primary-medium, #888); margin: 3px 0 0; }
  .agq-box .btn { margin-top: 12px; }
  .agq-box .masked { font-family: monospace; color: var(--primary-medium, #777); font-size: 12px; }
</style>

<div class="agq-wrap">
  <h2>🦥 Sloth AI Plugin</h2>

  <% if @save_error %>
    <div class="agq-error">⚠️ 儲存設定失敗：<%= @save_error %></div>
  <% elsif @saved %>
    <div class="agq-saved">✅ 設定已儲存，已同步至 bridge（無需重啟）。</div>
  <% end %>

  <% if current_user&.admin? %>
    <div class="agq-box">
      <h3>⚙️ 設定 / Settings</h3>
      <%= form_tag "/admin/plugins/sloth-ai/settings", method: :post do %>
        <label for="opencode_api_key">OpenCode Go API Key（deepseek / mimo）</label>
        <% oc = @settings.find { |s| s[:setting].to_s == "gemini_opencode_api_key" }
           oc_set = oc && oc[:value].present? %>
        <input type="password" id="opencode_api_key" name="opencode_api_key"
               value="" autocomplete="new-password"
               placeholder="<%= oc_set ? "已設定 (#{oc[:value].to_s[0,10]}…)，留空則不變更" : "輸入 API key" %>">
        <div class="hint">留空 = 保留目前的 key。儲存後 plugin 自動推送到 bridge，立即生效。</div>

        <label for="bridge_token">Bridge Token</label>
        <% bt = @settings.find { |s| s[:setting].to_s == "gemini_bridge_token" } %>
        <input type="password" id="bridge_token" name="bridge_token" value="" autocomplete="new-password"
               placeholder="<%= bt && bt[:value].present? ? "已設定，留空則不變更" : "輸入 bridge token" %>">

        <label for="bridge_url">Bridge URL</label>
        <input type="text" id="bridge_url" name="bridge_url" value=""
               placeholder="<%= (@settings.find { |s| s[:setting].to_s == "gemini_bridge_url" }&.dig(:value) || "http://127.0.0.1:8787") %>">

        <div style="margin-top:18px;border-top:1px solid var(--primary-low, #ddd);padding-top:12px;">
          <label for="model">預設模型（chat / deep research）</label>
          <input type="text" id="model" name="model" value=""
                 placeholder="<%= @settings.find { |s| s[:setting].to_s == "gemini_model" }&.dig(:value) || "gemini-3.5-flash" %>">

          <label for="daily_limit">每用戶每日呼叫上限</label>
          <input type="number" id="daily_limit" name="daily_limit" value=""
                 placeholder="<%= @settings.find { |s| s[:setting].to_s == "gemini_daily_limit_per_user" }&.dig(:value) %>">

          <label for="history_posts">聊天時帶入的先前貼文數</label>
          <input type="number" id="history_posts" name="history_posts" value=""
                 placeholder="<%= @settings.find { |s| s[:setting].to_s == "gemini_chat_history_posts" }&.dig(:value) %>">

          <label for="allowed_groups">允許呼喚 bot 的群組（用 | 分隔）</label>
          <input type="text" id="allowed_groups" name="allowed_groups" value=""
                 placeholder="<%= @settings.find { |s| s[:setting].to_s == "gemini_allowed_groups" }&.dig(:value) || "trust_level_1|trust_level_2|trust_level_3|trust_level_4" %>">
        </div>

        <%= submit_tag "全部儲存", class: "btn btn-primary", style: "margin-top:14px" %>
      <% end %>
    </div>
  <% end %>

  <% if current_user&.admin? && @models %>
    <div class="agq-box">
      <h3>🤖 模型啟用管理 / Enable Models</h3>
      <div class="hint" style="margin-bottom:10px;">
        勾選 = 啟用（使用者可以在論壇 @ 該 bot 使用）；取消勾選 = 停用（不再回應，且無貼文的 bot 帳號會被刪除）。
        帳號命名已統一為 <code>ai_{model}</code>（例如 gemini-3.6-flash → ai_gemini-3.6-flash）。
        若同名裸版與 tiered 版同時啟用，tiered 版會保留後綴區分（gemini-3.7-flash → ai_gemini-3.7-flash，gemini-3.7-flash-tiered → ai_gemini-3.7-tiered）。
      </div>
      <%= form_tag "/admin/plugins/sloth-ai/bots", method: :post do %>
        <% config = DiscourseGemini.bot_config
           used = config.values
           ag_ids = (@models["antigravity"] || []).map { |m| m["id"] }
           oc_ids = (@models["opencode"] || []).map { |m| m["id"] }
           # include current-config models that the quota list may not expose
           # (e.g. plain gemini-3.6-flash vs tiered variants)
           ag_extra = (used - ag_ids - oc_ids).map { |i| { "id" => i, "name" => i } }
           ag_all = ag_extra + (@models["antigravity"] || []) %>
        <div style="font-weight:600;font-size:13px;color:var(--primary-medium,#777);margin:6px 0 4px;">Google AI Pro（Antigravity）</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:4px 12px;">
          <% ag_all.each do |m| %>
            <% id = m["id"]
               name = DiscourseGemini.normalize_model_name(m["name"] || id)
               bot = DiscourseGemini.bot_username_for(id)
               enabled = config.key?(bot) || used.include?(id)
               no_alias = !DiscourseGemini.valid_bot_username?(bot) %>
            <label style="display:flex;gap:8px;align-items:center;font-size:13px;margin:2px 0;cursor:pointer;">
              <input type="checkbox" name="model[]" value="<%= id %>" <%= enabled ? "checked" : "" %> <%= no_alias ? "disabled title=\"無法產生 20 字內帳號\"" : "" %>>
              <span><%= name %></span>
            </label>
          <% end %>
        </div>
        <div style="font-weight:600;font-size:13px;color:var(--primary-medium,#777);margin:10px 0 4px;">OpenCode Go（deepseek / mimo）</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:4px 12px;">
          <% (@models["opencode"] || []).each do |m| %>
            <% id = m["id"]
               name = DiscourseGemini.normalize_model_name(id)
               bot = DiscourseGemini.bot_username_for(id)
               enabled = config.key?(bot) || used.include?(id)
               no_alias = !DiscourseGemini.valid_bot_username?(bot) %>
            <label style="display:flex;gap:8px;align-items:center;font-size:13px;margin:2px 0;cursor:pointer;">
              <input type="checkbox" name="model[]" value="<%= id %>" <%= enabled ? "checked" : "" %> <%= no_alias ? "disabled title=\"無法產生 20 字內帳號\"" : "" %>>
              <span><%= name %></span>
            </label>
          <% end %>
        </div>
        <%= submit_tag "儲存啟用設定", class: "btn btn-primary", style: "margin-top:14px" %>
      <% end %>
    </div>
  <% end %>

  <% if @error %>
    <div class="agq-error">⚠️ 無法讀取配額：<%= @error %></div>
  <% elsif @quota && @quota["models"].present? %>
    <div class="agq-sub">
      資料擷取於 <%= Time.at(@quota["fetched_at"]).in_time_zone.strftime("%Y-%m-%d %H:%M:%S") %>（本機時間）·
      來源 fetchAvailableModels/quotaInfo + OpenCode /usage ·
      <a href="/admin/plugins/sloth-ai" data-auto-route-alt="">重新整理</a>
    </div>
    <table>
      <thead><tr><th>模型</th><th>剩餘額度</th><th>重設倒數</th></tr></thead>
      <tbody>
      <% @quota["models"].each do |m| %>
        <% frac = m["remaining"].to_f; pct = frac * 100.0
           color = frac > 0.5 ? "#16a34a" : (frac > 0.1 ? "#ca8a04" : "#dc2626") %>
        <tr>
          <td>
            <%= m["name"] %>
            <div class="agq-key"><%= m["key"] %></div>
          </td>
          <td>
            <div class="agq-bar"><div class="agq-fill" style="width:<%= pct.round(1) %>%;background:<%= color %>"></div></div>
            <span class="agq-pct"><%= format("%.2f", pct) %>%</span>
          </td>
          <td class="agq-reset" data-reset="<%= m["reset_time"] %>">—</td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <script>
      (function () {
        function tick() {
          document.querySelectorAll("td.agq-reset").forEach(function (el) {
            var iso = el.getAttribute("data-reset");
            if (!iso) { el.textContent = "—"; return; }
            var t = new Date(iso).getTime() - Date.now();
            if (t <= 0) { el.textContent = "已重設 ✓"; el.classList.add("agq-warn"); return; }
            var s = Math.floor(t / 1000);
            var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
            el.textContent = h + "h " + m + "m " + sec + "s";
            if (s < 900) el.classList.add("agq-warn");
          });
        }
        tick();
        setInterval(tick, 1000);
      })();
    </script>
  <% end %>

  <% if @quota && @quota["opencode"] && @quota["opencode"]["models"].present? %>
    <h2 style="margin-top:28px;font-size:16px;">🚀 OpenCode Go（deepseek-v4-flash / mimo-v2.5）</h2>
    <table>
      <thead><tr><th>方案時間窗</th><th>剩餘額度</th><th>重設倒數</th></tr></thead>
      <tbody>
      <% @quota["opencode"]["models"].each do |m| %>
        <% frac = m["remaining"].to_f; pct = frac * 100.0
           color = frac > 0.5 ? "#16a34a" : (frac > 0.1 ? "#ca8a04" : "#dc2626") %>
        <tr>
          <td>
            <%= m["name"] %>
            <div class="agq-key"><%= m["key"] %></div>
          </td>
          <td>
            <div class="agq-bar"><div class="agq-fill" style="width:<%= pct.round(1) %>%;background:<%= color %>"></div></div>
            <span class="agq-pct"><%= format("%.2f", pct) %>%</span>
          </td>
          <td class="agq-reset" data-reset="<%= m["reset_time"] %>">—</td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <script>
      (function () {
        function tick() {
          document.querySelectorAll("td.agq-reset").forEach(function (el) {
            var iso = el.getAttribute("data-reset");
            if (!iso) { el.textContent = "—"; return; }
            var t = new Date(iso).getTime() - Date.now();
            if (t <= 0) { el.textContent = "已重設 ✓"; el.classList.add("agq-warn"); return; }
            var s = Math.floor(t / 1000);
            var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
            el.textContent = h + "h " + m + "m " + sec + "s";
            if (s < 900) el.classList.add("agq-warn");
          });
        }
        tick();
        setInterval(tick, 1000);
      })();
    </script>
  <% end %>
</div>