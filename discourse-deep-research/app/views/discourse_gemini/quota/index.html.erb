<%- # Sloth AI — public: quota monitor; admin: + subscription status/reauth. -%>
<style>
  .agq-wrap { max-width: 900px; padding: 8px 0 24px; font-size: 14px; }
  .agq-wrap table { width: 100%; border-collapse: collapse; }
  .agq-wrap th { text-align: left; font-size: 12px; color: var(--primary-medium, #666);
                 padding: 6px 8px; border-bottom: 1px solid var(--primary-low, #ddd); }
  .agq-wrap td { padding: 8px; border-bottom: 1px solid var(--primary-low, #ddd);
                 vertical-align: middle; }
  .agq-key { color: var(--primary-medium, #777); font-size: 11px; font-family: monospace; }
  .agq-bar { background: var(--primary-low, #e5e5e5); border-radius: 5px; height: 10px;
             min-width: 180px; overflow: hidden; }
  .agq-fill { height: 100%; border-radius: 5px; }
  .agq-pct { margin-left: 8px; font-variant-numeric: tabular-nums; font-size: 13px; }
  .agq-reset { color: var(--primary-medium, #777); font-variant-numeric: tabular-nums; font-size: 13px; }
  .agq-warn { color: #c00; }
  .agq-sub { color: var(--primary-medium, #777); font-size: 13px; margin-bottom: 14px; }
  .agq-error { background: #fdecea; border: 1px solid #f5c6c6; color: #a33; padding: 12px; border-radius: 6px; }
  .agq-saved { background: #e7f6ec; border: 1px solid #b5dfc4; color: #167b3a; padding: 10px 12px; border-radius: 6px; margin-bottom: 12px; }
  .agq-box { border: 1px solid var(--primary-low, #ddd); border-radius: 8px; padding: 14px 16px; margin-bottom: 20px; }
  .agq-box h3 { margin: 0 0 10px; font-size: 15px; }
  .agq-box label { display: block; font-size: 13px; margin: 10px 0 4px; color: var(--primary-medium, #666); }
  .agq-box input[type="text"] { width: 100%; max-width: 520px; padding: 6px 8px;
    border: 1px solid var(--primary-low-mid, #bbb); border-radius: 4px; font-family: monospace; font-size: 13px;
    background: var(--secondary, #fff); color: var(--primary, #222); }
  .agq-box .hint { font-size: 12px; color: var(--primary-medium, #888); margin: 3px 0 0; }
</style>

<div class="agq-wrap">
  <h2><%= @admin_page ? "🦥 Sloth AI 管理 / Admin" : "🎫 AI Token 額度 / Quota Monitor" %></h2>

  <% if @reauth_error %>
    <div class="agq-error">⚠️ <%= @reauth_error %></div>
  <% end %>
  <% if @reauth_ok %>
    <div class="agq-saved"><%= @reauth_ok %></div>
  <% end %>

  <% if @admin_page && current_user&.admin? && @auth_status %>
    <div class="agq-box">
      <h3>🔑 Google AI Pro 訂閱狀態 / Auth Status</h3>
      <% st = @auth_status; acc = st["account"] || {}
         tok = st["token"] || {}; ref = st["refresh"] || {} %>
      <table style="margin-bottom:10px;">
        <tbody>
          <tr><td style="width:180px;">帳號</td><td><%= acc["email"] || "—" %>（<%= acc["name"] || "?" %>）</td></tr>
          <tr><td>認證狀態</td>
            <td>
              <% if st["ok"] %>
                <span style="color:#16a34a;">✅ 正常（自動續期中）</span>
              <% elsif st["configured"] %>
                <span style="color:#ca8a04;">⚠️ 需要重新認證</span>
              <% else %>
                <span style="color:#dc2626;">❌ 尚未設定</span>
              <% end %>
            </td></tr>
          <tr><td>Token 到期</td><td class="agq-key"><%= tok["fresh_expiry"] ? "#{tok["fresh_expiry"][0,19]}（#{tok["expires_in_s"].to_i / 60} 分鐘後）" : "—" %></td></tr>
          <tr><td>Refresh token</td>
            <td><% if ref["ok"] %><span style="color:#16a34a;">✅ 有效</span><% elsif ref["ok"] == false %><span style="color:#dc2626;">❌ 失效：<%= ref["error"] %></span><% else %>—<% end %></td></tr>
          <tr><td>Client secret</td><td><%= st["client_secret_set"] ? "✅ 已設定" : "❌ 未設定（無法續期）" %></td></tr>
        </tbody>
      </table>

      <% if @reauth_url.present? %>
        <div style="margin:10px 0;padding:10px;background:#f0f7ff;border:1px solid #bcd9f5;border-radius:6px;">
          <div style="font-weight:600;margin-bottom:6px;">步驟 1/2：用你的 Google 帳號開啟以下連結並授權</div>
          <a href="<%= @reauth_url %>" target="_blank" style="word-break:break-all;font-family:monospace;font-size:12px;"><%= @reauth_url %></a>
          <div class="hint" style="margin-top:6px;">授權後複製 callback 網址或 code。</div>
        </div>
        <%= form_tag "/admin/plugins/sloth-ai/reauth/exchange", method: :post do %>
          <input type="hidden" name="verifier" value="<%= @reauth_verifier %>">
          <label for="reauth_code">步驟 2/2：貼上 Google 回傳的 code</label>
          <input type="text" id="reauth_code" name="code" placeholder="4/0A… 或完整 callback 網址">
          <%= submit_tag "完成認證", class: "btn btn-primary", style: "margin-top:8px" %>
        <% end %>
      <% else %>
        <%= form_tag "/admin/plugins/sloth-ai/reauth", method: :post do %>
          <%= submit_tag "重新認證 Google AI Pro", class: "btn btn-default", style: "margin-top:4px" %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @error %>
    <div class="agq-error">⚠️ 無法讀取配額：<%= @error %></div>
  <% elsif @quota && @quota["models"].present? %>
    <div class="agq-sub">
      資料擷取於 <%= Time.at(@quota["fetched_at"]).in_time_zone.strftime("%Y-%m-%d %H:%M:%S") %>（本機時間）·
      來源 Google AI Pro（Antigravity）·
      <a href="<%= @admin_page ? "/admin/plugins/sloth-ai" : "/sloth-ai" %>" data-auto-route-alt="">重新整理</a>
    </div>
    <table>
      <thead><tr><th>模型</th><th>剩餘額度</th><th>重設倒數</th></tr></thead>
      <tbody>
      <% seen = Set.new
         @quota["models"].each do |m| %>
        <% name = m["name"] || m["key"]
           next if seen.include?(name)
           seen << name
           frac = m["remaining"].to_f; pct = frac * 100.0
           color = frac > 0.5 ? "#16a34a" : (frac > 0.1 ? "#ca8a04" : "#dc2626") %>
        <tr>
          <td>
            <%= name %>
            <div class="agq-key"><%= m["key"] %></div>
          </td>
          <td>
            <div class="agq-bar"><div class="agq-fill" style="width:<%= pct.round(1) %>%;background:<%= color %>"></div></div>
            <span class="agq-pct"><%= format("%.2f", pct) %>%</span>
          </td>
          <td class="agq-reset" data-reset="<%= m["reset_time"] %>">—</td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <script>
      (function () {
        function tick() {
          document.querySelectorAll("td.agq-reset").forEach(function (el) {
            var iso = el.getAttribute("data-reset");
            if (!iso) { el.textContent = "—"; return; }
            var t = new Date(iso).getTime() - Date.now();
            if (t <= 0) { el.textContent = "已重設 ✓"; el.classList.add("agq-warn"); return; }
            var s = Math.floor(t / 1000);
            var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
            el.textContent = h + "h " + m + "m " + sec + "s";
            if (s < 900) el.classList.add("agq-warn");
          });
        }
        tick();
        setInterval(tick, 1000);
      })();
    </script>
  <% else %>
    <p>無資料。</p>
  <% end %>
</div>
